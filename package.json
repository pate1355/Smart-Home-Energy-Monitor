{
  "name": "smart-home-energy-monitor",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered smart home energy monitoring application",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "server": "tsx server/index.ts",
    "server:watch": "tsx watch server/index.ts",
    "start": "npm run server",
    "dev:all": "concurrently \"npm run server:watch\" \"npm run dev\"",
    "dev:backend": "npm run server:watch",
    "dev:frontend": "npm run dev"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "groq-sdk": "^0.37.0",
    "lucide-react": "^0.390.0",
    "mongoose": "^9.1.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@netlify/functions": "^5.1.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "nodemon": "^3.1.11",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.1"
  }
}